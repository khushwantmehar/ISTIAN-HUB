# Copy this file to .env and fill in real values.

PORT=4100

# A long random string used to sign login sessions. Any value works, but keep
# it secret and consistent — changing it logs everyone out.
JWT_SECRET=change-this-to-a-long-random-string

# The ONE admin/teacher account, created automatically the first time the
# server starts. There is no public "sign up as admin" option — this is the
# only way to create an admin account, on purpose, so students can't grant
# themselves upload access.
ADMIN_NAME=Class Teacher
ADMIN_EMAIL=teacher@istianhub.local
ADMIN_PASSWORD=change-this-password
